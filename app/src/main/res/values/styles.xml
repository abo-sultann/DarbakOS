<resources>
    <!-- Internal theme name remains migration-safe; visible identity is GDN. -->
    <style name="Theme.Darbak" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorControlHighlight">#442E7D59</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">start</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">@dimen/space</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
    <style name="Action" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/touch_height</item>
        <item name="android:minHeight">@dimen/touch_height</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/action_background</item>
        <item name="android:paddingStart">@dimen/space</item>
        <item name="android:paddingEnd">@dimen/space</item>
    </style>
    <style name="NavAction" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
</resources>
