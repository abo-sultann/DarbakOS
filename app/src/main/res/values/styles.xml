<resources>
    <style name="Theme.Darbak" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_deep</item>
        <item name="android:colorControlHighlight">#4458C7FF</item>
    </style>

    <!-- Historical/default styles retained for the API25 regression layout. -->
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">start</item>
        <item name="android:textDirection">rtl</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">@dimen/space</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
    <style name="Action" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/touch_height</item>
        <item name="android:minHeight">@dimen/touch_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/action_background</item>
        <item name="android:paddingStart">@dimen/space</item>
        <item name="android:paddingEnd">@dimen/space</item>
    </style>
    <style name="NavAction" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <!-- P10 modern large-screen visual system. -->
    <style name="ModernBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/modern_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">start</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="ModernLabel" parent="ModernBody">
        <item name="android:textSize">@dimen/modern_label</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="ModernTitle" parent="ModernBody">
        <item name="android:textSize">@dimen/modern_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ModernCard">
        <item name="android:background">@drawable/modern_card_background</item>
        <item name="android:padding">@dimen/modern_gap</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
    <style name="ModernHeroCard" parent="ModernCard">
        <item name="android:background">@drawable/modern_hero_background</item>
    </style>
    <style name="ModernAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/modern_touch_height</item>
        <item name="android:minHeight">@dimen/modern_touch_height</item>
        <item name="android:textSize">@dimen/modern_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/modern_action_background</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ModernNavAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/modern_touch_height</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/modern_nav_action_background</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
