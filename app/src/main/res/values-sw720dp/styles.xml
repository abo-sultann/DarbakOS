<resources>
    <!-- Large head-unit presentation layer. Keeps the same IDs/layout contract while
         giving the production Full-HD+ surface stronger driving hierarchy. -->
    <style name="Body" parent="android:style/Widget.TextView">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Title" parent="Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">24dp</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="Action" parent="android:style/Widget.Button">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">@dimen/touch_height</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/action_background</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="NavAction" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_height</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
